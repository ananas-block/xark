# Generated by scripts/gen-publish-makefile.py for xark (v0.3.0) — don't edit.
# Publishes every crate to crates.io in dependency order (leaves first).
# `cargo publish` waits for each crate to index before the next, so deps
# are always available when a dependent is published.
#
# Usage:
#   make -f Makefile.publish publish-dry   # build every crate from its tarball, upload nothing
#                                          # (scripts/publish-dry.sh)
#   make -f Makefile.publish publish       # real publish (needs `cargo login`)

.PHONY: publish publish-dry $(addprefix pub-,$(PKGS))

PKGS := xark-curve xark-ir xark-macros xark-schema xark-verifier xark-frontend xark-groth16 xark-backend xark-prover xark-test-harness xark xark-cli xark-aes xark-bignum xark-bits xark-grumpkin xark-hash xark-mimc xark-pedersen xark-poseidon xark-poseidon2 xark-blake2s xark-blake3 xark-ed25519 xark-keccak xark-merkle xark-secp256k1 xark-secp256r1 xark-sha256

